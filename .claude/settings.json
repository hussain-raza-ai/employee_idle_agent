{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pytest:*)",
      "Bash(pip:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(rclone ls:*)",
      "Bash(rclone lsd:*)",
      "Bash(rclone copy:*)",
      "Bash(rclone mkdir:*)",
      "Bash(nvidia-smi:*)",
      "Bash(ffprobe:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(jq:*)",
      "Bash(bash scripts/vast/save_run.sh:*)",
      "Bash(bash scripts/vast/end_session.sh:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rclone delete:*)",
      "Bash(rclone purge:*)",
      "Bash(rclone sync:*)",
      "Bash(rm -rf /:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(~/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.config/rclone/**)"
    ]
  }
}
