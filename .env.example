# Copy to .env and adjust. .env is gitignored — never commit real values.
#
# On Vast.ai the five secrets below (GH_TOKEN, RCLONE_CONFIG_B2_*, B2_REMOTE)
# go in a file on your PC, e.g. %USERPROFILE%\vast-secrets\cctv.env, one
# KEY=VALUE per line. At the start of each session copy it to the instance:
#
#   scp "$HOME\vast-secrets\cctv.env" vast:/root/.cctv.env
#
# scripts/vast/load_env.sh loads it (Notepad's CRLF and BOM are stripped).
# Vast account environment variables also work, but a team "member" cannot
# edit them, and team-level ones would reach every member's instances.

# --- Repo / data layout on the instance -------------------------------------
# Repo checkout. The Vast PyTorch template puts persistent storage at /workspace.
REPO_DIR=/workspace/employee_idle_agent
# Where recordings land locally after being pulled from the bucket.
RECORDINGS_DIR=/workspace/employee_idle_agent/recordings
# Where a run writes events, evidence and preview.
OUTPUT_DIR=/workspace/employee_idle_agent/output

# --- Object storage (rclone) -------------------------------------------------
# rclone remote and bucket, as "remote:bucket". B2 bucket names are globally
# unique, so yours may carry a suffix.
B2_REMOTE=b2:cctv-idle-data
# These three let rclone work with no config file. Keep them out of git.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=

# --- GitHub ------------------------------------------------------------------
# Fine-grained token scoped to this repo only: Contents RW, Pull requests RW.
GH_TOKEN=

# --- Run defaults ------------------------------------------------------------
CAMERA_ID=cam-01
# Wall-clock start of the recording, ISO-8601. Without it events are dated 1970.
CLIP_START=2026-11-18T15:00:05+05:00
MODEL=yolov8s-pose.pt
TARGET_FPS=8
DEVICE=cuda:0
